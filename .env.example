-----------------------------
Application
-----------------------------

APP_NAME=Multi-Region-AIOps
APP_ENV=development
DEBUG=true

-----------------------------
API Gateway
-----------------------------

API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8081

-----------------------------
Firebase Authentication
-----------------------------
Get this from your Firebase project configuration.

FIREBASE_PROJECT_ID=your-firebase-project-id

-----------------------------
Production
-----------------------------
EDGE_PUBLIC_API_URL=/gateway

AUTH_SERVICE_URL=http://auth-service:8000
INFERENCE_SERVICE_URL=http://inference-service:8001
RESULT_SERVICE_URL=http://result-service:8002
INCIDENT_SERVICE_URL=http://incident-service:8003
REMEDIATION_SERVICE_URL=http://remediation-service:8004
NOTIFICATION_SERVICE_URL=http://notification-service:8005
INCIDENT_SERVICE_WS_URL=ws://incident-service:8003/ws/incidents

-----------------------------
Auth Service
-----------------------------

AUTH_HOST=0.0.0.0
AUTH_PORT=8000

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

-----------------------------
Inference Service
-----------------------------

INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8001

MODEL_PATH=models/isolation_forest.pkl

REDIS_URL=redis://redis:6379/0

-----------------------------
Result Service
-----------------------------

RESULT_HOST=0.0.0.0
RESULT_PORT=8002

DATABASE_URL=postgresql://user:password@postgres:5432/aiops

-----------------------------
Incident Management Service
-----------------------------

INCIDENT_HOST=0.0.0.0
INCIDENT_PORT=8003

Shared internal service authentication key.

INTERNAL_API_KEY=replace-with-a-long-random-internal-key

-----------------------------
AIOps Engine
-----------------------------

PROMETHEUS_URL=http://prometheus:9090

ANOMALY_THRESHOLD=0.8
CHECK_INTERVAL_SECONDS=30
REMEDIATION_COOLDOWN_SECONDS=300

MONITORED_SERVICES=inference-service,result-service,api-gateway,auth-service,incident-service

RCA_CPU_THRESHOLD=90
RCA_MEMORY_THRESHOLD=95
RCA_DISK_THRESHOLD=90
RCA_LATENCY_THRESHOLD_MS=3000
RCA_ERROR_RATE_THRESHOLD=15
RCA_RESTART_THRESHOLD=3
RCA_QUEUE_THRESHOLD=100

-----------------------------
Remediation Service
-----------------------------

REMEDIATION_HOST=0.0.0.0
REMEDIATION_PORT=8004

VERIFICATION_WAIT_SECONDS=10
VERIFICATION_MAX_RETRIES=3
VERIFICATION_RETRY_INTERVAL_SECONDS=5

-----------------------------
Notification Service
-----------------------------

NOTIFICATION_HOST=0.0.0.0
NOTIFICATION_PORT=8005

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=aiops-platform@example.com
NOTIFY_EMAIL_TO=

-----------------------------
PostgreSQL
-----------------------------

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

POSTGRES_DB=aiops
POSTGRES_USER=user
POSTGRES_PASSWORD=change-this-password

-----------------------------
Redis
-----------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

-----------------------------
Frontend
-----------------------------

FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8081
VITE_GRAFANA_URL=http://localhost:3001
VITE_PROMETHEUS_URL=http://localhost:9090

-----------------------------
Prometheus
-----------------------------

PROMETHEUS_PORT=9090

CADVISOR_PORT=8085
NODE_EXPORTER_PORT=9100

-----------------------------
Grafana
-----------------------------

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

-----------------------------
Loki
-----------------------------

LOKI_PORT=3100

-----------------------------
Logging
-----------------------------

LOG_LEVEL=INFO

-----------------------------
Kubernetes
-----------------------------

KUBERNETES_ENABLED=false
KUBECONFIG=/root/.kube/config

-----------------------------
CORS
-----------------------------

ALLOWED_ORIGINS=http://localhost:3000

-----------------------------
AI Model
-----------------------------

ISOLATION_FOREST_N_ESTIMATORS=100
ISOLATION_FOREST_CONTAMINATION=0.05

-----------------------------
Health Checks
-----------------------------

HEALTH_CHECK_INTERVAL=30
REQUEST_TIMEOUT=10